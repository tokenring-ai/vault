{
  "name": "@tokenring-ai/vault",
  "version": "0.2.0",
  "description": "Secure storage service for managing sensitive API keys and persistent credentials.",
  "dependencies": {
    "@tokenring-ai/app": "workspace:*",
    "@tokenring-ai/agent": "workspace:*",
    "@tokenring-ai/utility": "workspace:*",
    "@tokenring-ai/rpc": "workspace:*",
    "@types/fs-extra": "^11.0.4",
    "commander": "^15.0.0",
    "fs-extra": "^11.3.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^6.0.2"
  },
  "exports": {
    ".": "./index.ts",
    "./*": "./*.ts"
  },
  "bin": {
    "vault": "./dist/vault"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build",
    "release:patch": "NEWVERSION=`bun pm version patch` && git add package.json && git commit -m \"Bump version to ${NEWVERSION}\" && git tag ${NEWVERSION} && git push && git push --tags",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage"
  },
  "license": "MIT",
  "type": "module"
}